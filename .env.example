# ---- Общие ----
NODE_ENV=development
APP_URL=http://localhost:3000
# Секрет для подписи сессий, ссылок на файлы и CSRF. Сгенерируйте: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# ---- База данных (PostgreSQL из docker-compose) ----
DATABASE_URL=postgresql://evotech:evotech@localhost:5432/evotech?schema=public

# ---- Почта ----
# MAIL_TRANSPORT=console — письма пишутся в лог и в таблицу OutboundEmail
# MAIL_TRANSPORT=smtp — отправка через SMTP (в dev — Mailpit, веб-интерфейс http://localhost:8025)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="EvoTechnology <no-reply@evotechnology.su>"

# ---- Файлы ----
# STORAGE_DRIVER=local (каталог STORAGE_DIR) | s3 (заготовка адаптера)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
FILE_MAX_SIZE_MB=50
FILE_LINK_TTL_SECONDS=300
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- AI ----
# AI_PROVIDER=mock (демонстрационный) | claude
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Платежи Т-Банк ----
# PAYMENT_PROVIDER=mock (демо-эквайринг внутри приложения) | tbank
PAYMENT_PROVIDER=mock
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
MOCK_AI_DELAY_MS=2500
