# HTTPS-прокси: сертификаты Let's Encrypt выпускаются и продлеваются автоматически,
# как только DNS-записи доменов указывают на сервер.

# Основной адрес платформы
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# Дополнительные адреса — постоянное перенаправление на основной
www.{$DOMAIN}, lk.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
